    // =========================================================
    // LOOKUPS
    // =========================================================

    private async Task LoadLookupsAsync()
    {
        try
        {
            var typeTask =
                VehicleTypeService.GetAllAsync();


            var kindTask =
                VehicleKindService.GetAllAsync();


            await Task.WhenAll(
                typeTask,
                kindTask);


            _vehicleTypes =
                (await typeTask)
                    .OrderBy(
                        x => x.TypeName)
                    .ToList();


            _vehicleKinds =
                (await kindTask)
                    .OrderBy(
                        x => x.KindName)
                    .ToList();
        }
        catch (ApiException exception)
        {
            _errorMessage =
                exception.Message;
        }
        catch (HttpRequestException)
        {
            _errorMessage =
                "Araç tanımları yüklenirken API sunucusuna ulaşılamadı.";
        }
        catch
        {
            _errorMessage =
                "Araç tanımları yüklenirken beklenmeyen bir hata oluştu.";
        }
    }


    // =========================================================
    // LOAD VEHICLES
    // =========================================================

    private async Task LoadVehiclesAsync()
    {
        _isLoading =
            true;


        _errorMessage =
            null;


        try
        {
            _result =
                await VehicleService.GetAllAsync(
                    search:
                        _search,

                    vehicleTypeId:
                        _vehicleTypeId,

                    vehicleKindId:
                        _vehicleKindId,

                    isActive:
                        GetStatusFilter(),

                    sortBy:
                        "plate",

                    sortDirection:
                        "asc",

                    page:
                        _page,

                    pageSize:
                        _pageSize);


            if (_result.TotalPages > 0 &&
                _page > _result.TotalPages)
            {
                _page =
                    _result.TotalPages;


                _result =
                    await VehicleService.GetAllAsync(
                        search:
                            _search,

                        vehicleTypeId:
                            _vehicleTypeId,

                        vehicleKindId:
                            _vehicleKindId,

                        isActive:
                            GetStatusFilter(),

                        sortBy:
                            "plate",

                        sortDirection:
                            "asc",

                        page:
                            _page,

                        pageSize:
                            _pageSize);
            }
        }
        catch (ApiException exception)
        {
            _errorMessage =
                exception.Message;
        }
        catch (HttpRequestException)
        {
            _errorMessage =
                "API sunucusuna ulaşılamadı.";
        }
        catch (TaskCanceledException)
        {
            _errorMessage =
                "Araç listesi isteği zaman aşımına uğradı.";
        }
        catch
        {
            _errorMessage =
                "Araçlar yüklenirken beklenmeyen bir hata oluştu.";
        }
        finally
        {
            _isLoading =
                false;
        }
    }


