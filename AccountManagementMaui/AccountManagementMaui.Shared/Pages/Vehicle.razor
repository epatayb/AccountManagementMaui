    // =========================================================
    // HELPERS
    // =========================================================

    private bool IsAnyOperationRunning()
    {
        return
            _isLoading ||
            _isLoadingVehicle ||
            _isSaving ||
            _isChangingStatus ||
            _isDeleting;
    }


    private bool? GetStatusFilter()
    {
        return _statusFilter switch
        {
            "active" =>
                true,

            "passive" =>
                false,

            _ =>
                null
        };
    }


    private int GetTotalPages()
    {
        return _result.TotalPages <= 0
            ? 1
            : _result.TotalPages;
    }


    private string GetVehicleFormTitle()
    {
        return _editingVehicleId.HasValue
            ? "Araç Bilgilerini Güncelle"
            : "Yeni Araç";
    }


    private string GetVehicleFormDescription()
    {
        return _editingVehicleId.HasValue
            ? "Seçilen araç kartının bilgilerini düzenleyin."
            : "Yeni araç kartının bilgilerini girin.";
    }


    private string GetVehicleSubmitText()
    {
        return _editingVehicleId.HasValue
            ? "Değişiklikleri Kaydet"
            : "Araç Kaydet";
    }


    private string GetStatusModalTitle()
    {
        if (_vehiclePendingStatus is null)
        {
            return "Araç Durumu";
        }


        return _vehiclePendingStatus.IsActive
            ? "Aracı Pasife Al"
            : "Aracı Aktif Et";
    }


    private static string GetBrandModel(
        VehicleListDto vehicle)
    {
        return string.Join(
            " / ",
            new[]
            {
                vehicle.Brand,
                vehicle.Model
            }
            .Where(x =>
                !string.IsNullOrWhiteSpace(x)));
    }


    private static string DisplayValue(
        string? value)
    {
        return string.IsNullOrWhiteSpace(
            value)
            ? "-"
            : value;
    }


    private static string MaskIdentityNumber(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(
            value))
        {
            return "-";
        }


        if (value.Length < 5)
        {
            return "****";
        }


        return value[..2] +
               "*******" +
               value[^2..];
    }


    private static string MaskTaxNumber(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(
            value))
        {
            return "-";
        }


        if (value.Length < 4)
        {
            return "****";
        }


        return value[..2] +
               "******" +
               value[^2..];
    }


    private static string RenderDateText(
        string title,
        DateTime? date)
    {
        return date.HasValue
            ? $"{title}: {date.Value.ToString("dd.MM.yyyy", TurkishCulture)}"
            : $"{title}: -";
    }


    private static string FormatNullableDate(
        DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString(
                "dd.MM.yyyy",
                TurkishCulture)
            : "-";
    }


    private static string FormatDateTime(
        DateTime date)
    {
        return date.ToLocalTime()
            .ToString(
                "dd.MM.yyyy HH:mm",
                TurkishCulture);
    }


    private static string FormatNullableDateTime(
        DateTime? date)
    {
        return date.HasValue
            ? date.Value
                .ToLocalTime()
                .ToString(
                    "dd.MM.yyyy HH:mm",
                    TurkishCulture)
            : "-";
    }


    private static string? NormalizeOptional(
        string? value)
    {
        return string.IsNullOrWhiteSpace(
            value)
            ? null
            : value.Trim();
    }
}