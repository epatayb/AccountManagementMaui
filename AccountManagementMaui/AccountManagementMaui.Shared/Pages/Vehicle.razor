        _isChangingStatus =
            true;


        _actionErrorMessage =
            null;


        var newStatus =
            !_vehiclePendingStatus.IsActive;


        var plate =
            _vehiclePendingStatus.Plate;


        try
        {
            var request =
                new ChangeVehicleStatusRequest
                {
                    IsActive =
                        newStatus,

                    RowVersion =
                        _vehiclePendingStatus.RowVersion
                };


            await VehicleService
                .ChangeStatusAsync(
                    _vehiclePendingStatus.Id,
                    request);


            ResetStatusModal();


            _successMessage =
                newStatus
                    ? $"{plate} plakalı araç aktif hale getirildi."
                    : $"{plate} plakalı araç pasife alındı.";


            await LoadVehiclesAsync();
        }
        catch (ApiException exception)
