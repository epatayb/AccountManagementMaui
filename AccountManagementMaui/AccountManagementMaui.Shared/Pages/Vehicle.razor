@page "/vehicles"

@using System.Globalization

@using AccountManagementMaui.Shared.Components.Common
@using AccountManagementMaui.Shared.Components.VehicleComponents

@using AccountManagementMaui.Shared.Models.VehicleKindModels
@using AccountManagementMaui.Shared.Models.VehicleLookupModels
@using AccountManagementMaui.Shared.Models.VehicleModels
@using AccountManagementMaui.Shared.Models.VehicleTypeModels

@using AccountManagementMaui.Shared.Services.Common
@using AccountManagementMaui.Shared.Services.VehicleKindServices
@using AccountManagementMaui.Shared.Services.VehicleServices
@using AccountManagementMaui.Shared.Services.VehicleTypeServices


@inject IVehicleService VehicleService
@inject IVehicleTypeService VehicleTypeService
@inject IVehicleKindService VehicleKindService


<PageTitle>Araçlar</PageTitle>


<div class="vehicles-page">

    @* =========================================================
       TOOLBAR
       ========================================================= *@

    <header class="vehicles-toolbar">

        <div class="toolbar-title">

            <h1>
                Araçlar
            </h1>

            <span>
                @_result.TotalCount kayıt
            </span>

        </div>


        <div class="toolbar-controls">

            <form class="search-form"
                  @onsubmit="SearchAsync"
                  @onsubmit:preventDefault>

                <input type="search"
                       class="search-input"
                       placeholder="Plaka, dorse, şoför, ruhsat veya fatura hesabı ara..."
                       autocomplete="off"
                       disabled="@_isLoading"
                       @bind="_search"
                       @bind:event="oninput" />


                <select class="filter-select"
                        disabled="@_isLoading"
                        @bind="_vehicleTypeId">

                    <option value="">
                        Tüm Tipler
                    </option>

                    @foreach (var type in _vehicleTypes)
                    {
                        <option value="@type.Id">
                            @type.TypeName
                        </option>
                    }

                </select>


                <select class="filter-select"
                        disabled="@_isLoading"
                        @bind="_vehicleKindId">

                    <option value="">
                        Tüm Türler
                    </option>

                    @foreach (var kind in _vehicleKinds)
                    {
                        <option value="@kind.Id">
                            @kind.KindName
                        </option>
                    }

                </select>


                <select class="filter-select status-select"
                        disabled="@_isLoading"
                        @bind="_statusFilter">

                    <option value="">
                        Tüm Durumlar
                    </option>

                    <option value="active">
                        Aktif
                    </option>

                    <option value="passive">
                        Pasif
                    </option>

                </select>


                <button type="submit"
                        class="compact-button primary-button"
                        disabled="@_isLoading">
                    Ara
                </button>


                <button type="button"
                        class="compact-button secondary-button"
                        disabled="@_isLoading"
                        @onclick="ClearFiltersAsync">
                    Temizle
                </button>


                <button type="button"
                        class="compact-button secondary-button"
                        disabled="@_isLoading"
                        @onclick="RefreshAsync">
                    Yenile
                </button>

            </form>


            <button type="button"
                    class="compact-button new-button"
                    disabled="@IsAnyOperationRunning()"
                    @onclick="OpenCreateModal">
                + Yeni Araç
            </button>

        </div>

    </header>


    @* =========================================================
       SUCCESS
       ========================================================= *@

    @if (!string.IsNullOrWhiteSpace(
        _successMessage))
    {
        <div class="compact-message success-message">

            <span>
                @_successMessage
            </span>

        </div>
    }


    @* =========================================================
       LOAD ERROR
       ========================================================= *@

    @if (!string.IsNullOrWhiteSpace(
        _errorMessage))
    {
        <div class="compact-message error-message">

            <span>
                @_errorMessage
            </span>


            <button type="button"
                    class="message-button"
                    @onclick="RefreshAsync">
                Tekrar Dene
            </button>

        </div>
    }


    @* =========================================================
       TABLE
       ========================================================= *@

    <section class="vehicles-table-shell">

        <div class="table-scroll">

            <table class="vehicles-table">

                <thead>

                    <tr>

                        <th class="vehicle-column">
                            Araç
                        </th>

                        <th class="driver-column">
                            Şoför
                        </th>

                        <th class="account-column">
                            Ruhsat Carisi
                        </th>

                        <th class="account-column">
                            Fatura Hesabı
                        </th>

                        <th class="trailer-column">
                            Dorse
                        </th>

                        <th class="document-column">
                            Belgeler
                        </th>

                        <th class="status-column">
                            Durum
                        </th>

                        <th class="action-column">
                            İşlemler
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (_isLoading &&
                                        _result.Items.Count == 0)
                    {
                        <tr>

                            <td colspan="8"
                                class="table-state">

                                Araçlar yükleniyor...

                            </td>

                        </tr>
                    }
                    else if (_result.Items.Count == 0)
                    {
                        <tr>

                            <td colspan="8"
                                class="table-state">

                                Araç kaydı bulunamadı.

                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var vehicle in _result.Items)
                        {
                            <tr>

                                @* =================================
                                   VEHICLE
                                   ================================= *@

                                <td>

                                    <div class="vehicle-cell">

                                        <strong class="plate">
                                            @vehicle.Plate
                                        </strong>


                                        <span>
                                            @vehicle.VehicleTypeName
                                            ·
                                            @vehicle.VehicleKindName
                                        </span>


                                        @if (!string.IsNullOrWhiteSpace(
                                                                        vehicle.Brand) ||
                                                                        !string.IsNullOrWhiteSpace(
                                                                        vehicle.Model))
                                        {
                                            <small>
                                                @GetBrandModel(vehicle)
                                            </small>
                                        }

                                    </div>

                                </td>


                                @* =================================
                                   DRIVER
                                   ================================= *@

                                <td>

                                    <div class="driver-cell">

                                        <strong>
                                            @vehicle.DriverName
                                        </strong>


                                        <span>
                                            TC:
                                            @MaskIdentityNumber(
                                            vehicle.DriverIdentityNumber)
                                </span>


                                <span>
                                    @DisplayValue(
                                                                        vehicle.DriverPhoneNumber)
                                </span>

                            </div>

                        </td>


                        @* =================================
                                   LICENSE ACCOUNT
                                   ================================= *@

                        <td>

                            <div class="account-cell">

                                <strong>
                                    @vehicle.LicenseAccountCardName
                                </strong>


                                <span>
                                    @vehicle.LicenseOwnerCityName
                                </span>

                            </div>

                        </td>


                        @* =================================
                                   INVOICE
                                   ================================= *@

                        <td>

                            <div class="account-cell">

                                <strong>
                                    @vehicle.InvoiceAccountCardName
                                </strong>

                            </div>

                        </td>


                        @* =================================
                                   TRAILER
                                   ================================= *@

                        <td>

                            <span class="plate-secondary">

                                @DisplayValue(
                                                                vehicle.TrailerPlate)

                            </span>

                        </td>


                        @* =================================
                                   DOCUMENTS
                                   ================================= *@

                        <td>

                            <div class="document-cell">

                                <span>
                                    @RenderDateText(
                                                                        "Sigorta",
                                                                        vehicle.InsuranceExpiryDate)
                                </span>


                                <span>
                                    @RenderDateText(
                                                                        "Muayene",
                                                                        vehicle.InspectionExpiryDate)
                                </span>

                            </div>

                        </td>


                        @* =================================
                                   STATUS
                                   ================================= *@

                        <td>

                            <span class="status-badge @(vehicle.IsActive
                                                                          ? "active-status"
                                                                          : "passive-status")">

                                @(vehicle.IsActive
                                                                ? "Aktif"
                                                                : "Pasif")

                            </span>

                        </td>


                        @* =================================
                                   ACTIONS
                                   ================================= *@

                        <td>

                            <div class="row-actions">

                                <button type="button"
                                        class="row-action-button view-button"
                                        title="Görüntüle"
                                        disabled="@IsAnyOperationRunning()"
                                        @onclick="() => OpenDetailModalAsync(vehicle.Id)">
                                    Görüntüle
                                </button>


                                <button type="button"
                                        class="row-action-button edit-button"
                                        title="Düzenle"
                                        disabled="@IsAnyOperationRunning()"
                                        @onclick="() => OpenEditModalAsync(vehicle.Id)">
                                    Düzenle
                                </button>


                                <button type="button"
                                        class="row-action-button status-button"
                                        disabled="@IsAnyOperationRunning()"
                                        @onclick="() => OpenStatusModalAsync(vehicle.Id)">

                                    @(vehicle.IsActive
                                                                        ? "Pasife Al"
                                                                        : "Aktif Et")

                                </button>


                                        <button type="button"
                                                class="row-action-button delete-button"
                                                title="Sil"
                                                disabled="@IsAnyOperationRunning()"
                                                @onclick="() => OpenDeleteModalAsync(vehicle.Id)">
                                            Sil
                                        </button>

                                    </div>

                                </td>

                            </tr>
                                        }
                    }

                </tbody>

            </table>

        </div>


        @* =====================================================
           PAGINATION
           ===================================================== *@

        <footer class="table-footer">

            <div class="page-size-area">

                <span>
                    Sayfa başına
                </span>


                <select class="page-size-select"
                        value="@_pageSize"
                        disabled="@_isLoading"
                        @onchange="PageSizeChangedAsync">

                    <option value="25">
                        25
                    </option>

                    <option value="50">
                        50
                    </option>

                    <option value="100">
                        100
                    </option>

                </select>

            </div>


            <div class="pagination">

                <button type="button"
                        class="page-button"
                        disabled="@(_isLoading ||
                                                            _result.Page <= 1)"
                        @onclick="PreviousPageAsync">
                    ‹
                </button>


                <span class="page-info">

                    Sayfa

                    <strong>
                        @_result.Page
                    </strong>

                    /

                    <strong>
                        @GetTotalPages()
                    </strong>

                </span>


                <button type="button"
                        class="page-button"
                        disabled="@(_isLoading ||
                                                            _result.Page >=
                                                            GetTotalPages())"
                        @onclick="NextPageAsync">
                    ›
                </button>

            </div>

        </footer>

    </section>

</div>


@* =============================================================
   CREATE / UPDATE VEHICLE MODAL
   ============================================================= *@

<AppModal IsOpen="_showVehicleModal"
          Title="@GetVehicleFormTitle()"
          Description="@GetVehicleFormDescription()"
          Size="large"
          DisableClose="_isSaving"
          OnClose="CloseVehicleModal">

    @if (!string.IsNullOrWhiteSpace(
        _modalErrorMessage))
    {
        <div class="vehicle-modal-error">
            @_modalErrorMessage
        </div>
    }


    @if (_isLoadingVehicle)
    {
        <div class="vehicle-modal-loading">
            Araç bilgileri yükleniyor...
        </div>
    }
    else
    {
        <VehicleForm @key="_formKey"
                     State="_formState"
                     IsSubmitting="_isSaving"
                     SubmitText="@GetVehicleSubmitText()"
                     OnValidSubmit="SaveVehicleAsync"
                     OnCancel="CloseVehicleModal" />
    }

</AppModal>


@* =============================================================
   DETAIL MODAL
   ============================================================= *@

<AppModal IsOpen="_showDetailModal"
          Title="Araç Detayı"
          Description="Araç ve ilişkili kart bilgileri."
          Size="large"
          DisableClose="false"
          OnClose="CloseDetailModal">

    @if (!string.IsNullOrWhiteSpace(
        _actionErrorMessage))
    {
        <div class="vehicle-modal-error">
            @_actionErrorMessage
        </div>
    }


    @if (_selectedVehicle is null &&
        string.IsNullOrWhiteSpace(
        _actionErrorMessage))
    {
        <div class="vehicle-modal-loading">
            Araç bilgileri yükleniyor...
        </div>
    }
    else if (_selectedVehicle is not null)
    {
        <div class="vehicle-detail">

            @* =============================================
               VEHICLE
               ============================================= *@

            <section class="detail-section">

                <div class="detail-section-title">
                    Araç Bilgileri
                </div>


                <div class="detail-grid">

                    <div class="detail-item">

                        <span>Plaka</span>

                        <strong>
                            @_selectedVehicle.Plate
                        </strong>

                    </div>


                    <div class="detail-item">

                        <span>Araç Tipi</span>

                        <strong>
                            @_selectedVehicle.VehicleTypeName
                        </strong>

                    </div>


                    <div class="detail-item">

                        <span>Araç Türü</span>

                        <strong>
                            @_selectedVehicle.VehicleKindName
                        </strong>

                    </div>


                    <div class="detail-item">

                        <span>Dorse</span>

                        <strong>
                            @DisplayValue(
                            _selectedVehicle.TrailerPlate)
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Marka</span>

                    <strong>
                        @DisplayValue(
                                                _selectedVehicle.Brand)
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Model</span>

                    <strong>
                        @DisplayValue(
                                                _selectedVehicle.Model)
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Ülke</span>

                    <strong>
                        @DisplayValue(
                                                _selectedVehicle.Country)
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Durum</span>

                    <strong>
                        @(_selectedVehicle.IsActive
                                                ? "Aktif"
                                                : "Pasif")
                    </strong>

                    </div>

                </div>

            </section>


            @* =============================================
               DRIVER / REFERENCE
               ============================================= *@

            <section class="detail-section">

                <div class="detail-section-title">
                    Şoför ve Referans
                </div>


                <div class="detail-grid">

                    <div class="detail-item">

                        <span>Şoför</span>

                        <strong>
                            @_selectedVehicle.DriverName
                        </strong>

                    </div>


                    <div class="detail-item">

                        <span>Şoför TC</span>

                        <strong>
                            @MaskIdentityNumber(
                                                _selectedVehicle.DriverIdentityNumber)
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Şoför Telefon</span>

                    <strong>
                        @DisplayValue(
                                                _selectedVehicle.DriverPhoneNumber)
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Şoför Ruhsat Sahibidir</span>

                    <strong>
                        @(_selectedVehicle.DriverIsLicenseOwner
                                                ? "Evet"
                                                : "Hayır")
                    </strong>

                    </div>


                    <div class="detail-item">

                        <span>Referans</span>

                        <strong>
                            @DisplayValue(
                                                _selectedVehicle.ReferenceName)
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Referans Telefon</span>

                    <strong>
                        @DisplayValue(
                                                _selectedVehicle.ReferencePhoneNumber)
                    </strong>

                </div>

            </div>

        </section>


        @* =============================================
               ACCOUNTS
               ============================================= *@

        <section class="detail-section">

            <div class="detail-section-title">
                Cari Bilgileri
            </div>


            <div class="detail-grid">

                <div class="detail-item">

                    <span>Araç Ruhsat Carisi</span>

                    <strong>
                        @_selectedVehicle.LicenseAccountCardName
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Fatura Hesabı</span>

                    <strong>
                        @_selectedVehicle.InvoiceAccountCardName
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Referans Fatura Caridir</span>

                    <strong>
                        @(_selectedVehicle.ReferenceIsInvoiceAccount
                                                ? "Evet"
                                                : "Hayır")
                                                      </strong>

                </div>


                <div class="detail-item">

                    <span>Ruhsat Cari Fatura Caridir</span>

                    <strong>
                        @(_selectedVehicle.LicenseOwnerIsInvoiceAccount
                                                ? "Evet"
                                                : "Hayır")
                    </strong>

                                        </div>

                                    </div>

                                </section>


                                @* =============================================
               LICENSE OWNER
               ============================================= *@

                                <section class="detail-section">

                                    <div class="detail-section-title">
                                        Ruhsat Sahibi
                                    </div>


                                    <div class="detail-grid">

                                        <div class="detail-item">

                                            <span>Ad / Ünvan</span>

                                            <strong>
                                                @_selectedVehicle.LicenseOwnerName
                                            </strong>

                                        </div>


                                        <div class="detail-item">

                                            <span>TC No</span>

                                            <strong>
                                                @MaskIdentityNumber(
                                                _selectedVehicle.LicenseOwnerIdentityNumber)
                    </strong>

                    </div>


                    <div class="detail-item">

                        <span>Vergi No</span>

                        <strong>
                            @MaskTaxNumber(
                                                _selectedVehicle.LicenseOwnerTaxNumber)
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Şehir</span>

                    <strong>
                        @_selectedVehicle.LicenseOwnerCityName
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Vergi Dairesi</span>

                    <strong>
                        @DisplayValue(
                                                _selectedVehicle.LicenseOwnerTaxOfficeName)
                    </strong>

                </div>


                <div class="detail-item detail-item-wide">

                    <span>Adres</span>

                    <strong>
                        @DisplayValue(
                                                _selectedVehicle.LicenseOwnerAddress)
                    </strong>

                </div>

            </div>

        </section>


        @* =============================================
               AUTHORIZED / DOCUMENTS
               ============================================= *@

        <section class="detail-section">

            <div class="detail-section-title">
                Yetkili ve Belgeler
            </div>


            <div class="detail-grid">

                <div class="detail-item">

                    <span>Yetkili</span>

                    <strong>
                        @DisplayValue(
                                                _selectedVehicle.AuthorizedName)
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Yetkili Telefon</span>

                    <strong>
                        @DisplayValue(
                                                _selectedVehicle.AuthorizedPhone)
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Sigorta Bitiş</span>

                    <strong>
                        @FormatNullableDate(
                                                _selectedVehicle.InsuranceExpiryDate)
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Muayene Bitiş</span>

                    <strong>
                        @FormatNullableDate(
                                                _selectedVehicle.InspectionExpiryDate)
                    </strong>

                </div>

            </div>

        </section>


        @* =============================================
               AUDIT
               ============================================= *@

        <section class="detail-section">

            <div class="detail-section-title">
                Kayıt Bilgileri
            </div>


            <div class="detail-grid">

                <div class="detail-item">

                    <span>Oluşturan</span>

                    <strong>
                        @DisplayValue(
                                                _selectedVehicle.CreatedByUserFullName)
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Oluşturulma</span>

                    <strong>
                        @FormatDateTime(
                                                _selectedVehicle.CreatedDate)
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Güncelleyen</span>

                    <strong>
                        @DisplayValue(
                                                _selectedVehicle.ModifiedByUserFullName)
                    </strong>

                </div>


                <div class="detail-item">

                    <span>Son Güncelleme</span>

                    <strong>
                        @FormatNullableDateTime(
                                                _selectedVehicle.ModifiedDate)
                    </strong>

                </div>

            </div>

        </section>


        <div class="modal-actions">

            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="CloseDetailModal">
                Kapat
            </button>


            <button type="button"
                    class="btn btn-primary"
                    @onclick="EditSelectedVehicleAsync">
                Düzenle
            </button>

        </div>

    </div>
        }

</AppModal>


@* =============================================================
   STATUS MODAL
   ============================================================= *@

<AppModal IsOpen="_showStatusModal"
          Title="@GetStatusModalTitle()"
          Description="Araç durumunu değiştirmeden önce işlemi onaylayın."
          Size="small"
          DisableClose="_isChangingStatus"
          OnClose="CloseStatusModal">

    @if (!string.IsNullOrWhiteSpace(
        _actionErrorMessage))
    {
        <div class="vehicle-modal-error">
            @_actionErrorMessage
        </div>
    }


    @if (_vehiclePendingStatus is not null)
    {
        <div class="vehicle-confirmation">

            <p>

                <strong>
                    @_vehiclePendingStatus.Plate
                </strong>

                plakalı araç

                <strong>
                    @(_vehiclePendingStatus.IsActive
                                    ? "pasife"
                                    : "aktife")
            </strong>

                alınacaktır.

            </p>


        @if (_vehiclePendingStatus.IsActive)
            {
                <div class="status-warning">

                    Pasife alınan araç sistemde korunur ancak
                    aktif araç seçimlerinde kullanılmamalıdır.

                </div>
            }


            <div class="modal-actions">

                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@_isChangingStatus"
                        @onclick="CloseStatusModal">
                    Vazgeç
                </button>


                <button type="button"
                        class="btn btn-primary"
                        disabled="@_isChangingStatus"
                        @onclick="ChangeVehicleStatusAsync">

                    @if (_isChangingStatus)
                    {
                        <span>
                            İşleniyor...
                        </span>
                    }
                    else
                    {
                        <span>
                            @(_vehiclePendingStatus.IsActive
                                                ? "Pasife Al"
                                                : "Aktif Et")
                </span>
                                }

                </button>

            </div>

        </div>
    }

</AppModal>


@* =============================================================
   DELETE MODAL
   ============================================================= *@

<AppModal IsOpen="@(_vehiclePendingDelete is not null)"
          Title="Araç Kaydını Sil"
          Description="Silme işlemini tamamlamak için açıklama girin."
          Size="small"
          DisableClose="_isDeleting"
          OnClose="CloseDeleteModal">

    @if (!string.IsNullOrWhiteSpace(
        _actionErrorMessage))
    {
        <div class="vehicle-modal-error">
            @_actionErrorMessage
        </div>
    }


    @if (_vehiclePendingDelete is not null)
    {
        <EditForm Model="_deleteVehicleModel"
                  OnValidSubmit="DeleteVehicleAsync">

            <DataAnnotationsValidator />


            <div class="delete-confirmation">

                <p>

                    <strong>
                        @_vehiclePendingDelete.Plate
                    </strong>

                    plakalı araç kaydını silmek istediğinize
                    emin misiniz?

                </p>


                <div class="delete-warning">

                    Bu işlem fiziksel silme yapmaz.
                    Kayıt sistem geçmişinde korunur.

                </div>

            </div>


            <div class="delete-field">

                <label for="vehicle-delete-reason">

                    Silme Açıklaması

                    <span class="required-mark">
                        *
                    </span>

                </label>


                <InputTextArea id="vehicle-delete-reason"
                               class="form-control"
                               rows="4"
                               maxlength="500"
                               disabled="@_isDeleting"
                               @bind-Value="_deleteVehicleModel.DeleteReason" />


                <ValidationMessage For="@(() => _deleteVehicleModel.DeleteReason)" />

            </div>


            <div class="modal-actions">

                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@_isDeleting"
                        @onclick="CloseDeleteModal">
                    Vazgeç
                </button>


                <button type="submit"
                        class="btn btn-danger"
                        disabled="@_isDeleting">

                    @if (_isDeleting)
                    {
                        <span>
                            Siliniyor...
                        </span>
                    }
                    else
                    {
                        <span>
                            Kaydı Sil
                        </span>
                    }

                </button>

            </div>

        </EditForm>
    }

</AppModal>


@code {
    private static readonly CultureInfo TurkishCulture =
        CultureInfo.GetCultureInfo(
            "tr-TR");


    // =========================================================
    // LIST
    // =========================================================

    private VehicleListResponse _result =
        new()
        {
            Page = 1,
            PageSize = 25
        };


    private List<VehicleTypeListDto> _vehicleTypes =
        [];


    private List<VehicleKindListDto> _vehicleKinds =
        [];


    // =========================================================
    // FILTERS
    // =========================================================

    private string _search =
        string.Empty;


    private int? _vehicleTypeId;

    private int? _vehicleKindId;


    private string _statusFilter =
        string.Empty;


