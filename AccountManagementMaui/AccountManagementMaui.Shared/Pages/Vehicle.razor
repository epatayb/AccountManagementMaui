    // =========================================================
    // PAGINATION
    // =========================================================

    private async Task PreviousPageAsync()
    {
        if (_page <= 1)
        {
            return;
        }


        _page--;


        await LoadVehiclesAsync();
    }


    private async Task NextPageAsync()
    {
        if (_page >= GetTotalPages())
        {
            return;
        }


        _page++;


        await LoadVehiclesAsync();
    }


    private async Task PageSizeChangedAsync(
        ChangeEventArgs args)
    {
        if (!int.TryParse(
                args.Value?.ToString(),
                out var pageSize))
        {
            return;
        }


        if (pageSize is not 25 and
            not 50 and
            not 100)
        {
            return;
        }


        _pageSize =
            pageSize;


        _page =
            1;


        await LoadVehiclesAsync();
    }


