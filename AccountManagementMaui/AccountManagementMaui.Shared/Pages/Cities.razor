@page "/cities"

@using AccountManagementMaui.Shared.Components.CityComponents
@using AccountManagementMaui.Shared.Components.Common
@using AccountManagementMaui.Shared.Models.CityModels
@using AccountManagementMaui.Shared.Services.CityServices
@using AccountManagementMaui.Shared.Services.Common

@inject ICityService CityService

<PageTitle>İller</PageTitle>

<div class="definition-page">
    <header class="definition-toolbar">
        <h1 class="toolbar-heading">İller</h1>

        <form class="toolbar-controls"
              @onsubmit="SearchCitiesAsync"
              @onsubmit:preventDefault>

            <input type="search"
                   class="search-input"
                   placeholder="Kod veya il adı ara..."
                   maxlength="50"
                   autocomplete="off"
                   @bind="_search"
                   @bind:event="oninput" />

            <button type="submit"
                    class="compact-button secondary-button"
                    disabled="@_isLoading">
                Ara
            </button>

            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <button type="button"
                        class="compact-button secondary-button"
                        disabled="@_isLoading"
                        @onclick="ClearSearchAsync">
                    Temizle
                </button>
            }

            <button type="button"
                    class="compact-button secondary-button"
                    disabled="@_isLoading"
                    @onclick="RefreshCitiesAsync">
                Yenile
            </button>

            <button type="button"
                    class="compact-button primary-button"
                    disabled="@(_isLoading || _isSaving || _isDeleting)"
                    @onclick="OpenCreateModal">
                Yeni İl
            </button>
        </form>
    </header>

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="compact-message success-message">
            @_successMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_loadErrorMessage))
    {
        <div class="compact-message error-message">
            <span>@_loadErrorMessage</span>

            <button type="button"
                    class="message-button"
                    @onclick="RefreshCitiesAsync">
                Tekrar Dene
            </button>
        </div>
    }

    <section class="table-shell">
        <div class="table-scroll">
            <table class="definition-table">
                <thead>
                    <tr>
                        <th class="id-column">ID</th>
                        <th class="code-column">İl Kodu</th>
                        <th>İl Adı</th>
                        <th class="count-column">İlçe Sayısı</th>
                        <th class="actions-column">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @if (_isLoading && _cities.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="table-state">
                                Kayıtlar yükleniyor...
                            </td>
                        </tr>
                    }
                    else if (_cities.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="table-state">
                                Kayıt bulunamadı.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var city in _cities)
                        {
                            <tr>
                                <td class="id-cell">
                                    @city.Id
                                </td>

                                <td>
                                    <span class="code-badge">
                                        @city.CityCode
                                    </span>
                                </td>

                                <td class="name-cell">
                                    @city.Name
                                </td>

                                <td>
                                    @city.DistrictCount
                                </td>

                                <td>
                                    <div class="row-actions">
                                        <button type="button"
                                                class="row-button edit-button"
                                                disabled="@(_isLoading || _isSaving || _isDeleting)"
                                                @onclick="() => OpenEditModal(city)">
                                            Güncelle
                                        </button>

                                        <button type="button"
                                                class="row-button delete-button"
                                                disabled="@(_isLoading || _isSaving || _isDeleting)"
                                                @onclick="() => OpenDeleteModal(city)">
                                            Sil
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<AppModal IsOpen="_showFormModal"
          Title="@GetFormTitle()"
          Description="@GetFormDescription()"
          Size="medium"
          DisableClose="_isSaving"
          OnClose="CloseFormModal">

    @if (!string.IsNullOrWhiteSpace(_modalErrorMessage))
    {
        <div class="modal-message error-message">
            @_modalErrorMessage
        </div>
    }

    <CityForm Model="_formModel"
              ShowHeading="false"
              SubmitText="@GetSubmitText()"
              IsSubmitting="_isSaving"
              OnValidSubmit="SaveCityAsync"
              OnCancel="CloseFormModal" />
</AppModal>

<AppModal IsOpen="@(_cityPendingDelete is not null)"
          Title="Kaydı Sil"
          Description="Silme işlemini tamamlamak için açıklama girin."
          Size="small"
          DisableClose="_isDeleting"
          OnClose="CloseDeleteModal">

    <div class="delete-modal-content">
        @if (!string.IsNullOrWhiteSpace(_modalErrorMessage))
        {
            <div class="modal-message inline-modal-error">
                @_modalErrorMessage
            </div>
        }

        @if (_cityPendingDelete is not null)
        {
            <p class="delete-confirmation">
                <strong>
                    @_cityPendingDelete.CityCode -
                    @_cityPendingDelete.Name
                </strong>

                kaydını silmek istediğinize emin misiniz?
            </p>

            <EditForm Model="_deleteModel"
                      OnValidSubmit="DeleteCityAsync">

                <DataAnnotationsValidator />

                <div class="delete-field">
                    <label for="delete-reason">
                        Silme Açıklaması
                    </label>

                    <InputTextArea id="delete-reason"
                                   class="form-control"
                                   rows="4"
                                   maxlength="500"
                                   disabled="@_isDeleting"
                                   @bind-Value="_deleteModel.DeleteReason" />

                    <ValidationMessage For="@(() => _deleteModel.DeleteReason)" />
                </div>

                <div class="delete-modal-actions">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@_isDeleting"
                            @onclick="CloseDeleteModal">
                        Vazgeç
                    </button>

                    <button type="submit"
                            class="btn btn-danger"
                            disabled="@_isDeleting">

                        @if (_isDeleting)
                        {
                            <span>Siliniyor...</span>
                        }
                        else
                        {
                            <span>Kaydı Sil</span>
                        }
                    </button>
                </div>
            </EditForm>
        }
    </div>
</AppModal>

@code {
    private List<CityListDto> _cities = [];

    private CityFormModel _formModel = new();
    private DeleteCityRequest _deleteModel = new();
    private CityListDto? _cityPendingDelete;

    private int? _editingCityId;

    private string _search = string.Empty;

    private string? _loadErrorMessage;
    private string? _modalErrorMessage;
    private string? _successMessage;

    private bool _isLoading;
    private bool _isSaving;
    private bool _isDeleting;
    private bool _showFormModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadCitiesAsync();
    }

    private void OpenCreateModal()
    {
        ResetDeleteModal();

        _editingCityId = null;
        _formModel = new CityFormModel();

        _modalErrorMessage = null;
        _successMessage = null;
        _showFormModal = true;
    }

    private void OpenEditModal(CityListDto city)
    {
        ResetDeleteModal();

        _editingCityId = city.Id;

        _formModel = new CityFormModel
        {
            CityCode = city.CityCode,
            Name = city.Name
        };

        _modalErrorMessage = null;
        _successMessage = null;
        _showFormModal = true;
    }

    private void CloseFormModal()
    {
        if (_isSaving)
        {
            return;
        }

        ResetFormModal();
    }

    private void ResetFormModal()
    {
        _showFormModal = false;
        _editingCityId = null;
        _formModel = new CityFormModel();
        _modalErrorMessage = null;
    }

    private async Task SaveCityAsync()
    {
        _isSaving = true;
        _modalErrorMessage = null;
        _successMessage = null;

        try
        {
            if (_editingCityId.HasValue)
            {
                var request = new UpdateCityRequest
                {
                    CityCode = _formModel.CityCode.Trim(),
                    Name = _formModel.Name.Trim()
                };

                var updatedCity = await CityService.UpdateAsync(
                    _editingCityId.Value,
                    request);

                _successMessage =
                    $"{updatedCity.CityCode} - {updatedCity.Name} güncellendi.";
            }
            else
            {
                var request = new CreateCityRequest
                {
                    CityCode = _formModel.CityCode.Trim(),
                    Name = _formModel.Name.Trim()
                };

                var createdCity =
                    await CityService.CreateAsync(request);

                _successMessage =
                    $"{createdCity.CityCode} - {createdCity.Name} eklendi.";
            }

            ResetFormModal();
            await LoadCitiesAsync();
        }
        catch (ApiException exception)
        {
            _modalErrorMessage = exception.Message;
        }
        catch (HttpRequestException)
        {
            _modalErrorMessage =
                "API sunucusuna ulaşılamadı.";
        }
        catch (TaskCanceledException)
        {
            _modalErrorMessage =
                "İstek zaman aşımına uğradı.";
        }
        catch
        {
            _modalErrorMessage =
                "Kayıt işlemi sırasında beklenmeyen bir hata oluştu.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenDeleteModal(CityListDto city)
    {
        ResetFormModal();

        _cityPendingDelete = city;
        _deleteModel = new DeleteCityRequest();

        _modalErrorMessage = null;
        _successMessage = null;
    }

    private void CloseDeleteModal()
    {
        if (_isDeleting)
        {
            return;
        }

        ResetDeleteModal();
    }

    private void ResetDeleteModal()
    {
        _cityPendingDelete = null;
        _deleteModel = new DeleteCityRequest();
        _modalErrorMessage = null;
    }

    private async Task DeleteCityAsync()
    {
        if (_cityPendingDelete is null)
        {
            return;
        }

        _isDeleting = true;
        _modalErrorMessage = null;
        _successMessage = null;

        var deletedCityText =
            $"{_cityPendingDelete.CityCode} - {_cityPendingDelete.Name}";

        try
        {
            _deleteModel.DeleteReason =
                _deleteModel.DeleteReason.Trim();

            await CityService.DeleteAsync(
                _cityPendingDelete.Id,
                _deleteModel);

            ResetDeleteModal();

            _successMessage =
                $"{deletedCityText} silindi.";

            await LoadCitiesAsync();
        }
        catch (ApiException exception)
        {
            _modalErrorMessage = exception.Message;
        }
        catch (HttpRequestException)
        {
            _modalErrorMessage =
                "API sunucusuna ulaşılamadı.";
        }
        catch (TaskCanceledException)
        {
            _modalErrorMessage =
                "Silme isteği zaman aşımına uğradı.";
        }
        catch
        {
            _modalErrorMessage =
                "Silme işlemi sırasında beklenmeyen bir hata oluştu.";
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private async Task SearchCitiesAsync()
    {
        _successMessage = null;
        await LoadCitiesAsync();
    }

    private async Task ClearSearchAsync()
    {
        _search = string.Empty;
        _successMessage = null;

        await LoadCitiesAsync();
    }

    private async Task RefreshCitiesAsync()
    {
        _successMessage = null;
        await LoadCitiesAsync();
    }

    private async Task LoadCitiesAsync()
    {
        _isLoading = true;
        _loadErrorMessage = null;

        try
        {
            var cities = await CityService.GetAllAsync(_search);
            _cities = cities.ToList();
        }
        catch (ApiException exception)
        {
            _loadErrorMessage = exception.Message;
        }
        catch (HttpRequestException)
        {
            _loadErrorMessage =
                "API sunucusuna ulaşılamadı. API projesinin çalıştığından emin olun.";
        }
        catch (TaskCanceledException)
        {
            _loadErrorMessage =
                "Listeleme isteği zaman aşımına uğradı.";
        }
        catch
        {
            _loadErrorMessage =
                "İller yüklenirken beklenmeyen bir hata oluştu.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetFormTitle()
    {
        return _editingCityId.HasValue
            ? "İl Bilgilerini Güncelle"
            : "Yeni İl Ekle";
    }

    private string GetFormDescription()
    {
        return _editingCityId.HasValue
            ? "Seçilen ilin bilgilerini düzenleyin."
            : "Yeni il kodunu ve adını girin.";
    }

    private string GetSubmitText()
    {
        return _editingCityId.HasValue
            ? "Kaydet"
            : "Ekle";
    }
}