    private async Task LicenseCityChangedAsync(
        ChangeEventArgs args)
    {
        int? cityId =
            null;


        if (int.TryParse(
                args.Value?.ToString(),
                out var parsedCityId) &&
            parsedCityId > 0)
        {
            cityId =
                parsedCityId;
        }


        State.Model.LicenseAccount.CityId =
            cityId;


        State.Model.LicenseAccount.TaxOfficeId =
            null;


        State.Model.LicenseOwnerCityId =
            cityId;


        State.Model.LicenseOwnerTaxOfficeId =
            null;


        await LoadTaxOfficesAsync(
            cityId);
    }


    private void LicenseTaxOfficeChanged(
        ChangeEventArgs args)
    {
        int? taxOfficeId =
            null;


        if (int.TryParse(
                args.Value?.ToString(),
                out var parsedTaxOfficeId) &&
            parsedTaxOfficeId > 0)
        {
            taxOfficeId =
                parsedTaxOfficeId;
        }


        State.Model.LicenseAccount.TaxOfficeId =
            taxOfficeId;


        State.Model.LicenseOwnerTaxOfficeId =
            taxOfficeId;
    }


    private async Task LoadTaxOfficesAsync(
        int? cityId)
    {
        _taxOffices.Clear();


        if (!cityId.HasValue ||
            cityId.Value <= 0)
        {
            return;
        }


        var items =
            await VehicleLookupService
                .GetTaxOfficesAsync(
                    cityId.Value);


        _taxOffices =
            items
                .OrderBy(
                    x => x.Name)
                .ToList();
    }


