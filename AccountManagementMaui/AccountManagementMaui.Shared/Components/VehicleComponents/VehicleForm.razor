        return new VehicleAccountInputDto
        {
            Title =
                item.Title,

            IdentityNumber =
                item.IdentityNumber,

            TaxNumber =
                item.TaxNumber,

            PhoneNumber =
                FormatPhoneNumber(
                    item.PhoneNumber),

            Email =
                item.Email,

            Address =
                item.Address,

            CityId =
                item.CityId,

            DistrictId =
                item.DistrictId,

            TaxOfficeId =
                item.TaxOfficeId
        };
    }

    private static VehicleAccountLookupDto ToLookup(
        VehicleAccountLookupDetailDto item)
    {
        return new VehicleAccountLookupDto
        {
            Id =
                item.Id,

            AccountCode =
                item.AccountCode,

            Title =
                item.Title,

            AccountCardTypeName =
                item.AccountCardTypeName,

            AccountCardKindName =
                item.AccountCardKindName,

            PhoneNumber =
                item.PhoneNumber,

            CityName =
                item.CityName
        };
    }


    private static VehicleAccountInputDto CloneAccount(
        VehicleAccountInputDto source)
    {
        return new VehicleAccountInputDto
        {
            Title =
                source.Title,

            IdentityNumber =
                source.IdentityNumber,

            TaxNumber =
                source.TaxNumber,

            PhoneNumber =
                source.PhoneNumber,

            Email =
                source.Email,

            Address =
                source.Address,

            CityId =
                source.CityId,

            DistrictId =
                source.DistrictId,

            TaxOfficeId =
                source.TaxOfficeId
        };
    }


    // =========================================================
    // SUBMIT
    // =========================================================

    private async Task HandleValidSubmitAsync()
    {
        /*
         * Manuel ruhsat bilgilerinin snapshot tarafında da
         * güncel kalmasını sağlıyoruz.
         */
        if (State.Model.DriverIsLicenseOwner)
        {
            ApplyDriverAsLicense();
        }
        else
        {
            SyncLegacyLicenseSnapshot(
                State.Model.LicenseAccount);
        }


        await OnValidSubmit.InvokeAsync();
    }


    private async Task CancelAsync()
    {
        await OnCancel.InvokeAsync();
    }
