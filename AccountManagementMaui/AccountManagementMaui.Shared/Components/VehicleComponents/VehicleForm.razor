    // =========================================================
    // FORMAT PHONE
    // =========================================================

    private static string FormatPhoneNumber(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(
            value))
        {
            return string.Empty;
        }


        var digits =
            new string(
                value
                    .Where(char.IsDigit)
                    .Take(10)
                    .ToArray());


        if (digits.Length == 0)
        {
            return string.Empty;
        }


        if (digits.Length <= 3)
        {
            return
                $"({digits}";
        }


        if (digits.Length <= 6)
        {
            return
                $"({digits[..3]})" +
                digits[3..];
        }


        return
            $"({digits[..3]})" +
            $"{digits.Substring(3, 3)}-" +
            digits[6..];
    }

