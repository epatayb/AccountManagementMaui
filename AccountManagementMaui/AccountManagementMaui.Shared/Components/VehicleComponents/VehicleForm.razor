    private void ClearLegacyLicenseSnapshot()
    {
        State.Model.LicenseOwnerName =
            null;


        State.Model.LicenseOwnerTaxNumber =
            null;


        State.Model.LicenseOwnerIdentityNumber =
            null;


        State.Model.LicenseOwnerAddress =
            null;


        State.Model.LicenseOwnerCityId =
            null;


        State.Model.LicenseOwnerTaxOfficeId =
            null;
    }


    private bool HasLegacyLicenseSnapshot()
    {
        return
            !string.IsNullOrWhiteSpace(
                State.Model.LicenseOwnerName) ||

            !string.IsNullOrWhiteSpace(
                State.Model.LicenseOwnerTaxNumber) ||

            !string.IsNullOrWhiteSpace(
                State.Model.LicenseOwnerIdentityNumber) ||

            !string.IsNullOrWhiteSpace(
                State.Model.LicenseOwnerAddress) ||

            State.Model.LicenseOwnerCityId.HasValue ||

            State.Model.LicenseOwnerTaxOfficeId.HasValue;
    }


    // =========================================================
    // STATE HELPERS
    // =========================================================

    private bool IsDriverManualDisabled()
    {
        return
            IsSubmitting ||
            State.Driver is not null;
    }


    private bool IsReferenceManualDisabled()
    {
        return
            IsSubmitting ||
            State.Reference is not null;
    }


    private bool IsLicenseManualDisabled()
    {
        return
            IsSubmitting ||

            State.Model.DriverIsLicenseOwner ||

            State.LicenseAccount is not null;
    }


    private bool IsInvoiceManualDisabled()
    {
        return
            IsSubmitting ||

            State.InvoiceAccount is not null ||

            State.Model.ReferenceIsInvoiceAccount ||

            State.Model.LicenseOwnerIsInvoiceAccount;
    }


    private bool HasDriverSource()
    {
        return
            State.Model.DriverAccountCardId.HasValue ||

            State.Model.DriverAccount.HasAnyValue();
    }


    private bool HasReferenceSource()
    {
        return
            State.Model.ReferenceAccountCardId.HasValue ||

            State.Model.ReferenceAccount.HasAnyValue();
    }


    private bool HasLicenseSource()
    {
        if (State.Model.DriverIsLicenseOwner)
        {
            return HasDriverSource();
        }


        return
            State.Model.LicenseAccountCardId.HasValue ||

            State.Model.LicenseAccount.HasAnyValue();
    }


