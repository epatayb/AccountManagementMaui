@using AccountManagementMaui.Shared.Models.VehicleKindModels
@using AccountManagementMaui.Shared.Models.VehicleLookupModels
@using AccountManagementMaui.Shared.Models.VehicleModels
@using AccountManagementMaui.Shared.Models.VehicleTypeModels

@using AccountManagementMaui.Shared.Services.Common
@using AccountManagementMaui.Shared.Services.VehicleKindServices
@using AccountManagementMaui.Shared.Services.VehicleLookupServices
@using AccountManagementMaui.Shared.Services.VehicleTypeServices


@inject IVehicleTypeService VehicleTypeService
@inject IVehicleKindService VehicleKindService
@inject IVehicleLookupService VehicleLookupService


<EditForm Model="State.Model"
          OnValidSubmit="HandleValidSubmitAsync">

    <DataAnnotationsValidator />


    <div class="vehicle-form">

        @if (!string.IsNullOrWhiteSpace(
                _loadErrorMessage))
        {
            <div class="form-message error">
                @_loadErrorMessage
            </div>
        }


        @* =====================================================
           ARAÇ
           ===================================================== *@

        <section class="form-section">

            <div class="section-header">
                <div>
                    <div class="section-title">
                        Araç Bilgileri
                    </div>

                    <div class="section-description">
                        Araca ait temel bilgileri girin.
                    </div>
                </div>
            </div>


            <div class="form-grid">

                <div class="form-field">

                    <label>
                        Plaka
                        <span class="required-mark">*</span>
                    </label>

                    <InputText class="form-control plate-input"
                               maxlength="20"
                               disabled="@IsSubmitting"
                               @bind-Value="State.Model.Plate" />

                    <ValidationMessage For="@(() => State.Model.Plate)" />

                </div>


                <div class="form-field">

                    <label>
                        Araç Tipi
                        <span class="required-mark">*</span>
                    </label>

                    <InputSelect class="form-control"
                                 disabled="@IsSubmitting"
                                 @bind-Value="State.Model.VehicleTypeId">

                        <option value="0">
                            Araç tipi seçiniz
                        </option>

                        @foreach (var item in _vehicleTypes)
                        {
                            <option value="@item.Id">
                                @item.TypeName
                            </option>
                        }

                    </InputSelect>

                    <ValidationMessage For="@(() => State.Model.VehicleTypeId)" />

                </div>


                <div class="form-field">

                    <label>
                        Araç Türü
                        <span class="required-mark">*</span>
                    </label>

                    <InputSelect class="form-control"
                                 disabled="@IsSubmitting"
                                 @bind-Value="State.Model.VehicleKindId">

                        <option value="0">
                            Araç türü seçiniz
                        </option>

                        @foreach (var item in _vehicleKinds)
                        {
                            <option value="@item.Id">
                                @item.KindName
                            </option>
                        }

                    </InputSelect>

                    <ValidationMessage For="@(() => State.Model.VehicleKindId)" />

                </div>


                <div class="form-field">

                    <label>Dorse Plakası</label>

                    <InputText class="form-control plate-input"
                               maxlength="20"
                               disabled="@IsSubmitting"
                               @bind-Value="State.Model.TrailerPlate" />

                </div>


                <div class="form-field">

                    <label>Marka</label>

                    <InputText class="form-control"
                               maxlength="100"
                               disabled="@IsSubmitting"
                               @bind-Value="State.Model.Brand" />

                </div>


                <div class="form-field">

                    <label>Model</label>

                    <InputText class="form-control"
                               maxlength="100"
                               disabled="@IsSubmitting"
                               @bind-Value="State.Model.Model" />

                </div>


                <div class="form-field full-width">

                    <label>Ülke</label>

                    <InputText class="form-control"
                               maxlength="100"
                               placeholder="Örnek: Türkiye"
                               disabled="@IsSubmitting"
                               @bind-Value="State.Model.Country" />

                </div>

            </div>

        </section>


        @* =====================================================
           ŞOFÖR
           ===================================================== *@

        <section class="form-section">

            <div class="section-header">

                <div>
                    <div class="section-title">
                        Şoför Bilgileri
                    </div>

                    <div class="section-description">
                        Mevcut şoförü seçebilir veya yeni şoför bilgilerini girebilirsiniz.
                    </div>
                </div>


                <label class="checkbox-label mode-checkbox">

                    <input type="checkbox"
                           checked="@State.Model.IsNewDriver"
                           disabled="@IsSubmitting"
                           @onchange="NewDriverChangedAsync" />

                    <span>
                        Yeni Şoför
                    </span>

                </label>

            </div>


            @if (!State.Model.IsNewDriver)
            {
                <div class="picker-wrapper">

                    <VehicleAccountPicker Label="Mevcut Şoför"
                                          Placeholder="Şoför adı, hesap kodu veya TC ara..."
                                          DriverOnly="true"
                                          Disabled="@IsSubmitting"
                                          SelectedItem="State.Driver"
                                          OnSelected="DriverSelectedAsync"
                                          OnCleared="DriverClearedAsync" />

                </div>
            }


            <div class="account-manual-area">

                <div class="manual-area-title">
                    @(State.Driver is null
                                        ? "Şoför Bilgileri"
                                        : "Seçili Şoför Bilgileri")
                </div>


                <div class="form-grid">

                    <div class="form-field">

                        <label>
                            Ad / Ünvan
                            <span class="required-mark">*</span>
                        </label>

                        <InputText class="form-control"
                                   maxlength="200"
                                   disabled="@IsDriverManualDisabled()"
                                   @bind-Value="State.Model.DriverAccount.Title" />

                    </div>


                    <div class="form-field">

                        <label>
                            Telefon
                            <span class="required-mark">*</span>
                        </label>

                        <input type="tel"
                               class="form-control"
                               maxlength="13"
                               inputmode="numeric"
                               placeholder="(___)___-____"
                               disabled="@IsDriverManualDisabled()"
                               value="@State.Model.DriverAccount.PhoneNumber"
                               @oninput="HandleDriverPhoneInput" />

                    </div>


                    <div class="form-field">

                        <label>TC No</label>

                        <InputText class="form-control"
                                   maxlength="11"
                                   inputmode="numeric"
                                   disabled="@IsDriverManualDisabled()"
                                   @bind-Value="State.Model.DriverAccount.IdentityNumber" />

                    </div>


                    <div class="form-field">

                        <label>Vergi No</label>

                        <InputText class="form-control"
                                   maxlength="10"
                                   inputmode="numeric"
                                   disabled="@IsDriverManualDisabled()"
                                   @bind-Value="State.Model.DriverAccount.TaxNumber" />

                    </div>


                    <div class="form-field full-width">

                        <label>E-posta</label>

                        <InputText class="form-control"
                                   maxlength="150"
                                   disabled="@IsDriverManualDisabled()"
                                   @bind-Value="State.Model.DriverAccount.Email" />

                    </div>


                    <div class="form-field full-width">

                        <label>Adres</label>

                        <InputTextArea class="form-control address-input"
                                       maxlength="500"
                                       rows="2"
                                       disabled="@IsDriverManualDisabled()"
                                       @bind-Value="State.Model.DriverAccount.Address" />

                    </div>

                </div>


                <ValidationMessage For="@(() => State.Model.DriverAccount)" />

            </div>


            <div class="checkbox-row">

                <label class="checkbox-label">

                    <input type="checkbox"
                           checked="@State.Model.DriverIsLicenseOwner"
                           disabled="@IsSubmitting"
                           @onchange="DriverIsLicenseOwnerChangedAsync" />

                    <span>
                        Şoför aynı zamanda ruhsat carisidir
                    </span>

                </label>

            </div>

        </section>


        @* =====================================================
           REFERANS
           ===================================================== *@

        <section class="form-section">

            <div class="section-header">

                <div>
                    <div class="section-title">
                        Referans Bilgileri
                    </div>

                    <div class="section-description">
                        Referans opsiyoneldir. Mevcut cari seçebilir veya yeni referans girebilirsiniz.
                    </div>
                </div>

            </div>


            <div class="picker-wrapper">

                <VehicleAccountPicker Label="Mevcut Referans"
                                      Placeholder="Referans cari ara..."
                                      Disabled="@IsSubmitting"
                                      SelectedItem="State.Reference"
                                      OnSelected="ReferenceSelectedAsync"
                                      OnCleared="ReferenceClearedAsync" />

            </div>


            <div class="account-manual-area">

                <div class="manual-area-title">
                    @(State.Reference is null
                                        ? "Yeni Referans Bilgileri"
                                        : "Seçili Referans Bilgileri")
                </div>


                <div class="form-grid">

                    <div class="form-field">

                        <label>Ad / Ünvan</label>

                        <InputText class="form-control"
                                   maxlength="200"
                                   disabled="@IsReferenceManualDisabled()"
                                   @bind-Value="State.Model.ReferenceAccount.Title" />

                    </div>


                    <div class="form-field">

                        <label>Telefon</label>

                        <input type="tel"
                               class="form-control"
                               maxlength="13"
                               inputmode="numeric"
                               placeholder="(___)___-____"
                               disabled="@IsReferenceManualDisabled()"
                               value="@State.Model.ReferenceAccount.PhoneNumber"
                               @oninput="HandleReferencePhoneInput" />

                    </div>


                    <div class="form-field">

                        <label>TC No</label>

                        <InputText class="form-control"
                                   maxlength="11"
                                   inputmode="numeric"
                                   disabled="@IsReferenceManualDisabled()"
                                   @bind-Value="State.Model.ReferenceAccount.IdentityNumber" />

                    </div>


                    <div class="form-field">

                        <label>Vergi No</label>

                        <InputText class="form-control"
                                   maxlength="10"
                                   inputmode="numeric"
                                   disabled="@IsReferenceManualDisabled()"
                                   @bind-Value="State.Model.ReferenceAccount.TaxNumber" />

                    </div>


                    <div class="form-field full-width">

                        <label>E-posta</label>

                        <InputText class="form-control"
                                   maxlength="150"
                                   disabled="@IsReferenceManualDisabled()"
                                   @bind-Value="State.Model.ReferenceAccount.Email" />

                    </div>


                    <div class="form-field full-width">

                        <label>Adres</label>

                        <InputTextArea class="form-control address-input"
                                       rows="2"
                                       maxlength="500"
                                       disabled="@IsReferenceManualDisabled()"
                                       @bind-Value="State.Model.ReferenceAccount.Address" />

                    </div>

                </div>


                <ValidationMessage For="@(() => State.Model.ReferenceAccount)" />

            </div>

        </section>


        @* =====================================================
           RUHSAT CARİ
           ===================================================== *@

        <section class="form-section">

            <div class="section-header">

                <div>
                    <div class="section-title">
                        Araç Ruhsat Cari Bilgileri
                    </div>

                    <div class="section-description">
                        Mevcut cari seçebilir veya yeni ruhsat carisi oluşturabilirsiniz.
                    </div>
                </div>

            </div>


            @if (State.Model.DriverIsLicenseOwner)
            {
                <div class="account-source-info">

                    <strong>
                        Şoför ruhsat carisi olarak kullanılacak.
                    </strong>

                    <span>
                        Ayrı bir hesap kartı oluşturulmayacak.
                    </span>

                </div>
            }
            else
            {
                <div class="picker-wrapper">

                    <VehicleAccountPicker Label="Mevcut Ruhsat Carisi"
                                          Placeholder="Ruhsat carisi ara..."
                                          Disabled="@IsSubmitting"
                                          SelectedItem="State.LicenseAccount"
                                          OnSelected="LicenseSelectedAsync"
                                          OnCleared="LicenseClearedAsync" />

                </div>
            }


            <div class="account-manual-area">

                <div class="manual-area-title">
                    @(State.Model.DriverIsLicenseOwner
                                        ? "Şoförden Alınan Bilgiler"
                                        : State.LicenseAccount is null
                                        ? "Yeni Ruhsat Cari Bilgileri"
                                        : "Seçili Ruhsat Cari Bilgileri")
                </div>


                <div class="form-grid">

                    <div class="form-field">

                        <label>Ad / Ünvan</label>

                        <InputText class="form-control"
                                   maxlength="200"
                                   disabled="@IsLicenseManualDisabled()"
                                   @bind-Value="State.Model.LicenseAccount.Title" />

                    </div>


                    <div class="form-field">

                        <label>Telefon</label>

                        <input type="tel"
                               class="form-control"
                               maxlength="13"
                               inputmode="numeric"
                               placeholder="(___)___-____"
                               disabled="@IsLicenseManualDisabled()"
                               value="@State.Model.LicenseAccount.PhoneNumber"
                               @oninput="HandleLicensePhoneInput" />

                    </div>


                    <div class="form-field">

                        <label>TC No</label>

                        <InputText class="form-control"
                                   maxlength="11"
                                   inputmode="numeric"
                                   disabled="@IsLicenseManualDisabled()"
                                   @bind-Value="State.Model.LicenseAccount.IdentityNumber" />

                    </div>


                    <div class="form-field">

                        <label>Vergi No</label>

                        <InputText class="form-control"
                                   maxlength="10"
                                   inputmode="numeric"
                                   disabled="@IsLicenseManualDisabled()"
                                   @bind-Value="State.Model.LicenseAccount.TaxNumber" />

                    </div>


                    <div class="form-field">

                        <label>Şehir</label>

                        <select class="form-control"
                                value="@GetNullableIdValue(State.Model.LicenseAccount.CityId)"
                                disabled="@IsLicenseManualDisabled()"
                                @onchange="LicenseCityChangedAsync">

                            <option value="">
                                Şehir seçiniz
                            </option>

                            @foreach (var city in _cities)
                            {
                                <option value="@city.Id">
                                    @city.CityCode - @city.Name
                                </option>
                            }

                        </select>

                    </div>


                    <div class="form-field">

                        <label>Vergi Dairesi</label>

                        <select class="form-control"
                                value="@GetNullableIdValue(State.Model.LicenseAccount.TaxOfficeId)"
                                disabled="@IsLicenseManualDisabled()"
                                @onchange="LicenseTaxOfficeChanged">

                            <option value="">
                                Vergi dairesi seçiniz
                            </option>

                            @foreach (var office in _taxOffices)
                            {
                                <option value="@office.Id">
                                    @office.Name
                                </option>
                            }

                        </select>

                    </div>


                    <div class="form-field full-width">

                        <label>E-posta</label>

                        <InputText class="form-control"
                                   maxlength="150"
                                   disabled="@IsLicenseManualDisabled()"
                                   @bind-Value="State.Model.LicenseAccount.Email" />

                    </div>


                    <div class="form-field full-width">

                        <label>Adres</label>

                        <InputTextArea class="form-control address-input"
                                       rows="2"
                                       maxlength="500"
                                       disabled="@IsLicenseManualDisabled()"
                                       @bind-Value="State.Model.LicenseAccount.Address" />

                    </div>

                </div>


                <ValidationMessage For="@(() => State.Model.LicenseAccount)" />

            </div>

        </section>


        @* =====================================================
           FATURA
           ===================================================== *@

        <section class="form-section">

            <div class="section-header">

                <div>
                    <div class="section-title">
                        Fatura Bilgileri
                    </div>

                    <div class="section-description">
                        Listede Müşteri ve Navluncu carileri gösterilir. Yeni kayıt Müşteri / Müşteri olarak açılır.
                    </div>
                </div>

            </div>


            <div class="invoice-checkboxes">

                <label class="checkbox-label">

                    <input type="checkbox"
                           checked="@State.Model.ReferenceIsInvoiceAccount"
                           disabled="@(IsSubmitting || !HasReferenceSource())"
                           @onchange="ReferenceInvoiceChangedAsync" />

                    <span>
                        Referans Fatura Carisidir
                    </span>

                </label>


                <label class="checkbox-label">

                    <input type="checkbox"
                           checked="@State.Model.LicenseOwnerIsInvoiceAccount"
                           disabled="@(IsSubmitting || !HasLicenseSource())"
                           @onchange="LicenseInvoiceChangedAsync" />

                    <span>
                        Ruhsat Carisi Fatura Carisidir
                    </span>

                </label>

            </div>


            @if (State.Model.ReferenceIsInvoiceAccount)
            {
                <div class="account-source-info">

                    <strong>
                        Fatura hesabı olarak referans kullanılacak.
                    </strong>

                </div>
            }
            else if (State.Model.LicenseOwnerIsInvoiceAccount)
            {
                <div class="account-source-info">

                    <strong>
                        Fatura hesabı olarak ruhsat carisi kullanılacak.
                    </strong>

                </div>
            }
            else
            {
                <div class="picker-wrapper">

                    <VehicleAccountPicker Label="Mevcut Fatura Hesabı"
                                          Placeholder="Müşteri veya navluncu ara..."
                                          InvoiceOnly="true"
                                          Disabled="@IsSubmitting"
                                          SelectedItem="State.InvoiceAccount"
                                          OnSelected="InvoiceSelectedAsync"
                                          OnCleared="InvoiceClearedAsync" />

                </div>


                <div class="account-manual-area">

                    <div class="manual-area-title">
                        @(State.InvoiceAccount is null
                                            ? "Yeni Fatura Cari Bilgileri"
                                            : "Seçili Fatura Cari Bilgileri")
                </div>


                    <div class="form-grid">

                        <div class="form-field">

                            <label>Ad / Ünvan</label>

                            <InputText class="form-control"
                                       maxlength="200"
                                       disabled="@IsInvoiceManualDisabled()"
                                       @bind-Value="State.Model.InvoiceAccount.Title" />

                        </div>


                        <div class="form-field">

                            <label>Telefon</label>

                            <input type="tel"
                                   class="form-control"
                                   maxlength="13"
                                   inputmode="numeric"
                                   placeholder="(___)___-____"
                                   disabled="@IsInvoiceManualDisabled()"
                                   value="@State.Model.InvoiceAccount.PhoneNumber"
                                   @oninput="HandleInvoicePhoneInput" />

                        </div>


                        <div class="form-field">

                            <label>TC No</label>

                            <InputText class="form-control"
                                       maxlength="11"
                                       inputmode="numeric"
                                       disabled="@IsInvoiceManualDisabled()"
                                       @bind-Value="State.Model.InvoiceAccount.IdentityNumber" />

                        </div>


                        <div class="form-field">

                            <label>Vergi No</label>

                            <InputText class="form-control"
                                       maxlength="10"
                                       inputmode="numeric"
                                       disabled="@IsInvoiceManualDisabled()"
                                       @bind-Value="State.Model.InvoiceAccount.TaxNumber" />

                        </div>


                        <div class="form-field full-width">

                            <label>E-posta</label>

                            <InputText class="form-control"
                                       maxlength="150"
                                       disabled="@IsInvoiceManualDisabled()"
                                       @bind-Value="State.Model.InvoiceAccount.Email" />

                        </div>


                        <div class="form-field full-width">

                            <label>Adres</label>

                            <InputTextArea class="form-control address-input"
                                           rows="2"
                                           maxlength="500"
                                           disabled="@IsInvoiceManualDisabled()"
                                           @bind-Value="State.Model.InvoiceAccount.Address" />

                        </div>

                    </div>


                    <ValidationMessage For="@(() => State.Model.InvoiceAccount)" />

                </div>
                        }

        </section>


        @* =====================================================
           YETKİLİ
           ===================================================== *@

        <section class="form-section">

            <div class="section-title">
                Yetkili
            </div>


            <div class="form-grid">

                <div class="form-field">

                    <label>Yetkili Adı</label>

                    <InputText class="form-control"
                               maxlength="100"
                               disabled="@IsSubmitting"
                               @bind-Value="State.Model.AuthorizedName" />

                </div>


                <div class="form-field">

                    <label>Yetkili Telefon</label>

                    <input type="tel"
                           class="form-control"
                           maxlength="13"
                           inputmode="numeric"
                           placeholder="(___)___-____"
                           disabled="@IsSubmitting"
                           value="@State.Model.AuthorizedPhone"
                           @oninput="HandleAuthorizedPhoneInput" />

                </div>

            </div>

        </section>


        @* =====================================================
           BELGELER
           ===================================================== *@

        <section class="form-section">

            <div class="section-title">
                Belge Tarihleri
            </div>


            <div class="form-grid">

                <div class="form-field">

                    <label>Sigorta Bitiş Tarihi</label>

                    <InputDate TValue="DateTime?"
                               class="form-control"
                               disabled="@IsSubmitting"
                               @bind-Value="State.Model.InsuranceExpiryDate" />

                </div>


                <div class="form-field">

                    <label>Muayene Bitiş Tarihi</label>

                    <InputDate TValue="DateTime?"
                               class="form-control"
                               disabled="@IsSubmitting"
                               @bind-Value="State.Model.InspectionExpiryDate" />

                </div>

            </div>

        </section>


        @* =====================================================
           BUTTONS
           ===================================================== *@

        <div class="form-actions">

            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@IsSubmitting"
                    @onclick="CancelAsync">
                Vazgeç
            </button>


            <button type="submit"
                    class="btn btn-primary"
                    disabled="@(IsSubmitting || _isLoading)">

                @(IsSubmitting
                                ? "Kaydediliyor..."
                                : SubmitText)

            </button>

        </div>

    </div>

</EditForm>


@code {

    // =========================================================
    // LOOKUPS
    // =========================================================

    private List<VehicleTypeListDto> _vehicleTypes =
        [];


    private List<VehicleKindListDto> _vehicleKinds =
        [];


    private List<VehicleCityLookupDto> _cities =
        [];


    private List<VehicleTaxOfficeLookupDto> _taxOffices =
        [];


    private VehicleAccountLookupDetailDto?
        _driverDetail;


    private VehicleAccountLookupDetailDto?
        _referenceDetail;


    private VehicleAccountLookupDetailDto?
        _licenseDetail;


    private VehicleAccountLookupDetailDto?
        _invoiceDetail;


    private bool _isLoading;


    private string? _loadErrorMessage;


    // =========================================================
    // PARAMETERS
    // =========================================================

    [Parameter, EditorRequired]
    public VehicleFormState State { get; set; } =
        new();


    [Parameter]
    public bool IsSubmitting { get; set; }


    [Parameter]
    public string SubmitText { get; set; } =
        "Kaydet";


    [Parameter]
    public EventCallback OnValidSubmit { get; set; }


    [Parameter]
    public EventCallback OnCancel { get; set; }


    // =========================================================
    // INITIALIZE
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadDefinitionsAsync();

        await InitializeStateDetailsAsync();
    }


    private async Task LoadDefinitionsAsync()
    {
        _isLoading =
            true;


        _loadErrorMessage =
            null;


        try
        {
            var typeTask =
                VehicleTypeService.GetAllAsync();


            var kindTask =
                VehicleKindService.GetAllAsync();


            var cityTask =
                VehicleLookupService.GetCitiesAsync();


            await Task.WhenAll(
                typeTask,
                kindTask,
                cityTask);


            _vehicleTypes =
                (await typeTask)
                    .OrderBy(
                        x => x.TypeName)
                    .ToList();


            _vehicleKinds =
                (await kindTask)
                    .OrderBy(
                        x => x.KindName)
                    .ToList();


            _cities =
                (await cityTask)
                    .OrderBy(
                        x => x.CityCode)
                    .ToList();
        }
        catch (ApiException exception)
        {
            _loadErrorMessage =
                exception.Message;
        }
        catch (HttpRequestException)
        {
            _loadErrorMessage =
                "Form tanımları yüklenirken API sunucusuna ulaşılamadı.";
        }
        catch
        {
            _loadErrorMessage =
                "Araç formu yüklenirken beklenmeyen bir hata oluştu.";
        }
        finally
        {
            _isLoading =
                false;
        }
    }


    // =========================================================
    // INITIAL STATE
    // =========================================================

    private async Task InitializeStateDetailsAsync()
    {
        try
        {
            // =================================================
            // DRIVER
            // =================================================

            if (State.Model.DriverAccountCardId.HasValue)
            {
                _driverDetail =
                    await VehicleLookupService
                        .GetAccountByIdAsync(
                            State.Model.DriverAccountCardId.Value);


                if (_driverDetail is not null)
                {
                    State.Driver ??=
                        ToLookup(
                            _driverDetail);


                    State.Model.DriverAccount =
                        ToInput(
                            _driverDetail);
                }
            }


            // =================================================
            // REFERENCE
            // =================================================

            if (State.Model.ReferenceAccountCardId.HasValue)
            {
                _referenceDetail =
                    await VehicleLookupService
                        .GetAccountByIdAsync(
                            State.Model.ReferenceAccountCardId.Value);


                if (_referenceDetail is not null)
                {
                    State.Reference ??=
                        ToLookup(
                            _referenceDetail);


                    State.Model.ReferenceAccount =
                        ToInput(
                            _referenceDetail);
                }
            }


            // =================================================
            // LICENSE
            // =================================================

            if (State.Model.LicenseAccountCardId.HasValue)
            {
                _licenseDetail =
                    await VehicleLookupService
                        .GetAccountByIdAsync(
                            State.Model.LicenseAccountCardId.Value);


                if (_licenseDetail is not null)
                {
                    State.LicenseAccount ??=
                        ToLookup(
                            _licenseDetail);


                    State.Model.LicenseAccount =
                        ToInput(
                            _licenseDetail);
                }
            }
            else if (
                !State.Model.DriverIsLicenseOwner &&
                HasLegacyLicenseSnapshot())
            {
                State.Model.LicenseAccount =
                    new VehicleAccountInputDto
                    {
                        Title =
                            State.Model.LicenseOwnerName,

                        IdentityNumber =
                            State.Model.LicenseOwnerIdentityNumber,

                        TaxNumber =
                            State.Model.LicenseOwnerTaxNumber,

                        Address =
                            State.Model.LicenseOwnerAddress,

                        CityId =
                            State.Model.LicenseOwnerCityId,

                        TaxOfficeId =
                            State.Model.LicenseOwnerTaxOfficeId
                    };
            }


            // =================================================
            // INVOICE
            // =================================================

            if (State.Model.InvoiceAccountCardId.HasValue)
            {
                _invoiceDetail =
                    await VehicleLookupService
                        .GetAccountByIdAsync(
                            State.Model.InvoiceAccountCardId.Value);


                if (_invoiceDetail is not null)
                {
                    State.InvoiceAccount ??=
                        ToLookup(
                            _invoiceDetail);


                    State.Model.InvoiceAccount =
                        ToInput(
                            _invoiceDetail);
                }
            }


            // =================================================
            // DRIVER = LICENSE
            // =================================================

            if (State.Model.DriverIsLicenseOwner)
            {
                ApplyDriverAsLicense();
            }


            await LoadTaxOfficesAsync(
                State.Model.LicenseAccount.CityId);
        }
        catch (ApiException exception)
        {
            _loadErrorMessage =
                exception.Message;
        }
        catch (HttpRequestException)
        {
            _loadErrorMessage =
                "Cari bilgileri yüklenirken API sunucusuna ulaşılamadı.";
        }
    }


