@using AccountManagementMaui.Shared.Models.AccountCardGroupModels
@using AccountManagementMaui.Shared.Models.AccountCardSubGroupModels

<EditForm Model="Model"
          OnValidSubmit="HandleValidSubmitAsync">

    <DataAnnotationsValidator />

    <div class="subgroup-form">

        <div class="form-field">
            <label for="group">
                Hesap Kart Grubu
                <span class="required-mark">*</span>
            </label>

            <InputSelect id="group"
                         class="form-control"
                         disabled="@IsSubmitting"
                         @bind-Value="Model.AccountCardGroupId">

                <option value="0">
                    Grup seçiniz
                </option>

                @foreach (var group in Groups)
                {
                    <option value="@group.Id">
                        @group.GroupName
                    </option>
                }

            </InputSelect>

            <ValidationMessage For="@(() => Model.AccountCardGroupId)" />
        </div>

        <div class="form-field">
            <label for="subgroup-name">
                Alt Grup Adı
                <span class="required-mark">*</span>
            </label>

            <InputText id="subgroup-name"
                       class="form-control"
                       maxlength="100"
                       placeholder="Alt grup adını giriniz"
                       autocomplete="off"
                       disabled="@IsSubmitting"
                       @bind-Value="Model.SubGroupName" />

            <ValidationMessage For="@(() => Model.SubGroupName)" />
        </div>

        <div class="form-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@IsSubmitting"
                    @onclick="HandleCancelAsync">
                Vazgeç
            </button>

            <button type="submit"
                    class="btn btn-primary"
                    disabled="@IsSubmitting">

                @if (IsSubmitting)
                {
                    <span>Kaydediliyor...</span>
                }
                else
                {
                    <span>@SubmitText</span>
                }

            </button>
        </div>

    </div>

</EditForm>

@code {
    [Parameter, EditorRequired]
    public AccountCardSubGroupFormModel Model { get; set; } = new();

    [Parameter]
    public IReadOnlyList<AccountCardGroupListDto> Groups { get; set; } =
        Array.Empty<AccountCardGroupListDto>();

    [Parameter]
    public string SubmitText { get; set; } = "Kaydet";

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private Task HandleValidSubmitAsync()
    {
        return OnValidSubmit.InvokeAsync();
    }

    private Task HandleCancelAsync()
    {
        return OnCancel.InvokeAsync();
    }
}