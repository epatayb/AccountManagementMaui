@using AccountManagementMaui.Shared.Models.AccountCardKindModels
@using AccountManagementMaui.Shared.Models.AccountCardTypeModels

<EditForm Model="Model"
          OnValidSubmit="HandleValidSubmitAsync">

    <DataAnnotationsValidator />

    <div class="card-kind-form">
        <div class="form-grid">
            <div class="form-field type-field">
                <label for="account-card-type">
                    Kart Tipi
                    <span class="required-mark">*</span>
                </label>

                <InputSelect id="account-card-type"
                             class="form-control"
                             disabled="@IsSubmitting"
                             @bind-Value="Model.AccountCardTypeId">

                    <option value="0">Kart tipi seçiniz</option>

                    @foreach (var type in AccountCardTypes)
                    {
                        <option value="@type.Id">
                            @type.TypeCode - @type.TypeName
                        </option>
                    }
                </InputSelect>

                <ValidationMessage For="@(() => Model.AccountCardTypeId)" />
            </div>

            <div class="form-field code-field">
                <label for="kind-code">
                    Kart Tür Kodu
                    <span class="required-mark">*</span>
                </label>

                <InputText id="kind-code"
                           class="form-control"
                           maxlength="7"
                           placeholder="Örnek: MUS"
                           autocomplete="off"
                           disabled="@IsSubmitting"
                           @bind-Value="Model.KindCode" />

                <ValidationMessage For="@(() => Model.KindCode)" />
            </div>

            <div class="form-field name-field">
                <label for="kind-name">
                    Kart Tür Adı
                    <span class="required-mark">*</span>
                </label>

                <InputText id="kind-name"
                           class="form-control"
                           maxlength="50"
                           placeholder="Örnek: Müşteri"
                           autocomplete="off"
                           disabled="@IsSubmitting"
                           @bind-Value="Model.KindName" />

                <ValidationMessage For="@(() => Model.KindName)" />
            </div>
        </div>

        <div class="form-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@IsSubmitting"
                    @onclick="HandleCancelAsync">
                Vazgeç
            </button>

            <button type="submit"
                    class="btn btn-primary"
                    disabled="@IsSubmitting">

                @if (IsSubmitting)
                {
                    <span>Kaydediliyor...</span>
                }
                else
                {
                    <span>@SubmitText</span>
                }
            </button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public AccountCardKindFormModel Model { get; set; } = new();

    [Parameter]
    public IReadOnlyList<AccountCardTypeListDto> AccountCardTypes
    {
        get;
        set;
    } = Array.Empty<AccountCardTypeListDto>();

    [Parameter]
    public string SubmitText { get; set; } = "Kaydet";

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private Task HandleValidSubmitAsync()
    {
        return OnValidSubmit.InvokeAsync();
    }

    private Task HandleCancelAsync()
    {
        return OnCancel.InvokeAsync();
    }
}