@using AccountManagementMaui.Shared.Models.CityModels
@using AccountManagementMaui.Shared.Models.TaxOfficeModels

<EditForm Model="Model"
          OnValidSubmit="HandleValidSubmitAsync">

    <DataAnnotationsValidator />

    <div class="tax-office-form">
        <div class="form-grid">
            <div class="form-field city-field">
                <label for="tax-office-city">
                    İl
                    <span class="required-mark">*</span>
                </label>

                <InputSelect id="tax-office-city"
                             class="form-control"
                             disabled="@IsSubmitting"
                             @bind-Value="Model.CityId">

                    <option value="0">İl seçiniz</option>

                    @foreach (var city in Cities)
                    {
                        <option value="@city.Id">
                            @city.CityCode - @city.Name
                        </option>
                    }
                </InputSelect>

                <ValidationMessage For="@(() => Model.CityId)" />
            </div>

            <div class="form-field code-field">
                <label for="tax-office-code">
                    Vergi Dairesi Kodu
                    <span class="required-mark">*</span>
                </label>

                <InputText id="tax-office-code"
                           class="form-control"
                           maxlength="20"
                           autocomplete="off"
                           disabled="@IsSubmitting"
                           @bind-Value="Model.TaxOfficeCode" />

                <ValidationMessage For="@(() => Model.TaxOfficeCode)" />
            </div>

            <div class="form-field name-field">
                <label for="tax-office-name">
                    Vergi Dairesi Adı
                    <span class="required-mark">*</span>
                </label>

                <InputText id="tax-office-name"
                           class="form-control"
                           maxlength="100"
                           autocomplete="off"
                           disabled="@IsSubmitting"
                           @bind-Value="Model.Name" />

                <ValidationMessage For="@(() => Model.Name)" />
            </div>
        </div>

        <div class="form-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@IsSubmitting"
                    @onclick="HandleCancelAsync">
                Vazgeç
            </button>

            <button type="submit"
                    class="btn btn-primary"
                    disabled="@IsSubmitting">

                @if (IsSubmitting)
                {
                    <span>Kaydediliyor...</span>
                }
                else
                {
                    <span>@SubmitText</span>
                }
            </button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public TaxOfficeFormModel Model { get; set; } = new();

    [Parameter]
    public IReadOnlyList<CityListDto> Cities { get; set; } =
        Array.Empty<CityListDto>();

    [Parameter]
    public string SubmitText { get; set; } = "Kaydet";

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private Task HandleValidSubmitAsync()
    {
        return OnValidSubmit.InvokeAsync();
    }

    private Task HandleCancelAsync()
    {
        return OnCancel.InvokeAsync();
    }
}