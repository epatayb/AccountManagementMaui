@using AccountManagementMaui.Shared.Models.UserModels
@using Microsoft.AspNetCore.Components.Forms

<EditForm EditContext="_editContext"
          OnValidSubmit="HandleValidSubmitAsync">

    <DataAnnotationsValidator />

    <div class="user-form">
        <div class="form-grid">
            <div class="form-field">
                <label for="first-name">
                    Ad
                    <span class="required-mark">*</span>
                </label>

                <InputText id="first-name"
                           class="form-control"
                           maxlength="50"
                           autocomplete="given-name"
                           disabled="@IsSubmitting"
                           @bind-Value="Model.FirstName" />

                <ValidationMessage For="@(() => Model.FirstName)" />
            </div>

            <div class="form-field">
                <label for="last-name">
                    Soyad
                    <span class="required-mark">*</span>
                </label>

                <InputText id="last-name"
                           class="form-control"
                           maxlength="50"
                           autocomplete="family-name"
                           disabled="@IsSubmitting"
                           @bind-Value="Model.LastName" />

                <ValidationMessage For="@(() => Model.LastName)" />
            </div>

            <div class="form-field">
                <label for="user-name">
                    Kullanıcı Adı
                    <span class="required-mark">*</span>
                </label>

                <InputText id="user-name"
                           class="form-control"
                           maxlength="50"
                           autocomplete="username"
                           disabled="@IsSubmitting"
                           @bind-Value="Model.UserName" />

                <ValidationMessage For="@(() => Model.UserName)" />
            </div>

            <div class="form-field">
                <label for="email">
                    E-Posta
                    <span class="required-mark">*</span>
                </label>

                <InputText id="email"
                           type="email"
                           class="form-control"
                           autocomplete="email"
                           disabled="@IsSubmitting"
                           @bind-Value="Model.Email" />

                <ValidationMessage For="@(() => Model.Email)" />
            </div>

            <div class="form-field phone-field">
                <label for="phone-number">
                    Telefon Numarası
                    <span class="required-mark">*</span>
                </label>

                <input id="phone-number"
                       type="tel"
                       class="form-control"
                       inputmode="numeric"
                       maxlength="13"
                       placeholder="(___)___-____"
                       autocomplete="tel"
                       disabled="@IsSubmitting"
                       value="@Model.PhoneNumber"
                       onkeydown="return event.ctrlKey ||
                                         event.metaKey ||
                                         event.altKey ||
                                         ['Backspace',
                                          'Delete',
                                          'Tab',
                                          'ArrowLeft',
                                          'ArrowRight',
                                          'Home',
                                          'End'].includes(event.key) ||
                                         /^[0-9]$/.test(event.key);"
                       @oninput="HandlePhoneInput" />

                <ValidationMessage For="@(() => Model.PhoneNumber)" />
            </div>

            <div class="password-section">
                <div class="password-heading">
                    <strong>
                        @(IsCreateMode
                                                ? "Parola Bilgileri"
                                                : "Parola Değişikliği")
                    </strong>

                    @if (!IsCreateMode)
                    {
                        <span>
                            Değiştirmek istemiyorsanız boş bırakın.
                        </span>
                    }
                </div>

                <div class="password-grid">
                    <div class="form-field">
                        <label for="password">
                            @(IsCreateMode ? "Parola" : "Yeni Parola")

                            @if (IsCreateMode)
                            {
                                <span class="required-mark">*</span>
                            }
                        </label>

                        <InputText id="password"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   disabled="@IsSubmitting"
                                   @bind-Value="Model.Password" />

                        <ValidationMessage For="@(() => Model.Password)" />
                    </div>

                    <div class="form-field">
                        <label for="confirm-password">
                            Parola Tekrar

                            @if (IsCreateMode)
                            {
                                <span class="required-mark">*</span>
                            }
                        </label>

                        <InputText id="confirm-password"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   disabled="@IsSubmitting"
                                   @bind-Value="Model.ConfirmPassword" />

                        <ValidationMessage For="@(() => Model.ConfirmPassword)" />
                    </div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@IsSubmitting"
                    @onclick="HandleCancelAsync">
                Vazgeç
            </button>

            <button type="submit"
                    class="btn btn-primary"
                    disabled="@IsSubmitting">

                @if (IsSubmitting)
                {
                    <span>Kaydediliyor...</span>
                }
                else
                {
                    <span>@SubmitText</span>
                }
            </button>
        </div>
    </div>
</EditForm>

@code {
    private EditContext _editContext = null!;
    private UserFormModel? _currentModel;

    [Parameter, EditorRequired]
    public UserFormModel Model { get; set; } = new();

    [Parameter]
    public bool IsCreateMode { get; set; }

    [Parameter]
    public string SubmitText { get; set; } = "Kaydet";

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    protected override void OnParametersSet()
    {
        Model.IsCreateMode = IsCreateMode;

        if (!ReferenceEquals(_currentModel, Model))
        {
            _currentModel = Model;
            _editContext = new EditContext(Model);
        }
    }

    private Task HandleValidSubmitAsync()
    {
        return OnValidSubmit.InvokeAsync();
    }

    private Task HandleCancelAsync()
    {
        return OnCancel.InvokeAsync();
    }

    private void HandlePhoneInput(ChangeEventArgs args)
    {
        var inputValue =
            args.Value?.ToString() ?? string.Empty;

        var digits = new string(
            inputValue
                .Where(char.IsDigit)
                .Take(10)
                .ToArray());

        Model.PhoneNumber =
            FormatPhoneNumber(digits);

        _editContext.NotifyFieldChanged(
            new FieldIdentifier(
                Model,
                nameof(Model.PhoneNumber)));
    }

    private static string FormatPhoneNumber(
        string digits)
    {
        if (string.IsNullOrEmpty(digits))
        {
            return string.Empty;
        }

        if (digits.Length <= 3)
        {
            return $"({digits}";
        }

        if (digits.Length <= 6)
        {
            return $"({digits[..3]}){digits[3..]}";
        }

        return
            $"({digits[..3]})" +
            $"{digits.Substring(3, 3)}-" +
            $"{digits[6..]}";
    }
}