@using AccountManagementMaui.Shared.Models.AccountCardGroupModels

<EditForm Model="Model"
          OnValidSubmit="HandleValidSubmitAsync">

    <DataAnnotationsValidator />

    <div class="group-form">
        <div class="form-field">
            <label for="group-name">
                Hesap Kart Grup Adı
                <span class="required-mark">*</span>
            </label>

            <InputText id="group-name"
                       class="form-control"
                       maxlength="100"
                       placeholder=""
                       autocomplete="off"
                       disabled="@IsSubmitting"
                       @bind-Value="Model.GroupName" />

            <ValidationMessage For="@(() => Model.GroupName)" />
        </div>

        <div class="form-actions">
            <button type="button"
                    class="btn btn-outline-secondary"
                    disabled="@IsSubmitting"
                    @onclick="HandleCancelAsync">
                Vazgeç
            </button>

            <button type="submit"
                    class="btn btn-primary"
                    disabled="@IsSubmitting">

                @if (IsSubmitting)
                {
                    <span>Kaydediliyor...</span>
                }
                else
                {
                    <span>@SubmitText</span>
                }
            </button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public AccountCardGroupFormModel Model { get; set; } = new();

    [Parameter]
    public string SubmitText { get; set; } = "Kaydet";

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private Task HandleValidSubmitAsync()
    {
        return OnValidSubmit.InvokeAsync();
    }

    private Task HandleCancelAsync()
    {
        return OnCancel.InvokeAsync();
    }
}