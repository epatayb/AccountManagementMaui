@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

@using AccountManagementMaui.Shared.Authentication
@using AccountManagementMaui.Shared.Services.AuthServices

@inject IAuthService AuthService
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<header class="top-navbar">

    <div class="top-navbar-inner">

        <NavLink class="brand"
                 href="/account-cards"
                 Match="NavLinkMatch.All">

            <span class="brand-logo">
                LTS
            </span>

        </NavLink>


        <button type="button"
                class="mobile-menu-button"
                aria-label="Menüyü aç veya kapat"
                aria-expanded="@_isMenuOpen"
                @onclick="ToggleMenu">

            <span></span>
            <span></span>
            <span></span>

        </button>


        <nav class="top-nav-links @GetMenuClass()">

            <NavLink class="top-nav-link"
                     href="/account-cards"
                     Match="NavLinkMatch.Prefix"
                     @onclick="CloseMenu">
                Hesap Kartları
            </NavLink>

            <NavLink class="top-nav-link"
                     href="/users"
                     Match="NavLinkMatch.Prefix"
                     @onclick="CloseMenu">
                Kullanıcılar
            </NavLink>

            <NavLink class="top-nav-link"
                     href="/cities"
                     Match="NavLinkMatch.Prefix"
                     @onclick="CloseMenu">
                İller
            </NavLink>

            <NavLink class="top-nav-link"
                     href="/districts"
                     Match="NavLinkMatch.Prefix"
                     @onclick="CloseMenu">
                İlçeler
            </NavLink>

            <NavLink class="top-nav-link"
                     href="/tax-offices"
                     Match="NavLinkMatch.Prefix"
                     @onclick="CloseMenu">
                Vergi Daireleri
            </NavLink>

            <NavLink class="top-nav-link"
                     href="/card-types"
                     Match="NavLinkMatch.Prefix"
                     @onclick="CloseMenu">
                Kart Tipleri
            </NavLink>

            <NavLink class="top-nav-link"
                     href="/card-kinds"
                     Match="NavLinkMatch.Prefix"
                     @onclick="CloseMenu">
                Kart Türleri
            </NavLink>

            <NavLink class="top-nav-link"
                     href="/card-groups"
                     Match="NavLinkMatch.Prefix"
                     @onclick="CloseMenu">
                Kart Grupları
            </NavLink>

            <NavLink class="top-nav-link"
                     href="/card-subgroups"
                     Match="NavLinkMatch.Prefix"
                     @onclick="CloseMenu">
                Alt Gruplar
            </NavLink>

        </nav>

        <AuthorizeView Context="authState">

            <Authorized>

                <div class="top-nav-user">

                    <div class="top-nav-avatar">
                        @GetInitials(authState.User)
                    </div>


                    <div class="top-nav-user-info">

                        <strong title="@GetFullName(authState.User)">
                            @GetFullName(authState.User)
                        </strong>

                        <span>
                            @GetUserName(authState.User)
                        </span>

                    </div>


                    <button type="button"
                            class="logout-button"
                            title="Oturumu kapat"
                            disabled="@_isLoggingOut"
                            @onclick="LogoutAsync">

                        @if (_isLoggingOut)
                        {
                            <span>
                                Çıkılıyor...
                            </span>
                        }
                        else
                        {
                            <span>
                                Çıkış
                            </span>
                        }

                    </button>

                </div>

            </Authorized>

        </AuthorizeView>

    </div>

</header>


@code {
    private bool _isMenuOpen;

    private bool _isLoggingOut;


    private void ToggleMenu()
    {
        _isMenuOpen = !_isMenuOpen;
    }


    private void CloseMenu()
    {
        _isMenuOpen = false;
    }


    private string GetMenuClass()
    {
        return _isMenuOpen
            ? "menu-open"
            : string.Empty;
    }

    private async Task LogoutAsync()
    {
        if (_isLoggingOut)
        {
            return;
        }


        _isLoggingOut = true;


        try
        {
            await AuthService.LogoutAsync();
        }
        finally
        {
            AuthStateProvider
                .NotifyUserLoggedOut();


            _isMenuOpen =
                false;


            _isLoggingOut =
                false;


            Navigation.NavigateTo(
                "/login",
                replace: true);
        }
    }


    // =========================================================
    // USER INFO
    // =========================================================

    private static string GetFullName(
        ClaimsPrincipal user)
    {
        var fullName =
            user.FindFirst("FullName")
                ?.Value;


        if (!string.IsNullOrWhiteSpace(
            fullName))
        {
            return fullName;
        }


        var firstName =
            user.FindFirst(
                ClaimTypes.GivenName)
                ?.Value;

        var lastName =
            user.FindFirst(
                ClaimTypes.Surname)
                ?.Value;


        var result =
            $"{firstName} {lastName}".Trim();


        return string.IsNullOrWhiteSpace(result)
            ? "Kullanıcı"
            : result;
    }


    private static string GetUserName(
        ClaimsPrincipal user)
    {
        return user.FindFirst(
                   ClaimTypes.Name)
                   ?.Value
               ?? user.Identity?.Name
               ?? string.Empty;
    }


    private static string GetInitials(
        ClaimsPrincipal user)
    {
        var firstName =
            user.FindFirst(
                ClaimTypes.GivenName)
                ?.Value;

        var lastName =
            user.FindFirst(
                ClaimTypes.Surname)
                ?.Value;


        var firstInitial =
            string.IsNullOrWhiteSpace(firstName)
                ? string.Empty
                : firstName[..1]
                    .ToUpperInvariant();


        var lastInitial =
            string.IsNullOrWhiteSpace(lastName)
                ? string.Empty
                : lastName[..1]
                    .ToUpperInvariant();


        var result =
            firstInitial +
            lastInitial;


        return string.IsNullOrWhiteSpace(result)
            ? "K"
            : result;
    }
}